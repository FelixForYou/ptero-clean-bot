# Token dari @BotFather
BOT_TOKEN=

# Telegram user ID yang boleh pakai bot (pisahkan koma kalau lebih dari satu)
# Cek ID kamu lewat command /whoami setelah bot jalan, atau lewat @userinfobot
ADMIN_IDS=123456789

# URL panel Pterodactyl kamu (tanpa trailing slash)
PTLA_URL=https://panel.domainkamu.com

# Application API Key dari panel: Admin -> Application API -> Create New (awalan ptla_)
PTLA_KEY=ptla_xxxxxxxxxxxxxxxxxxxxxxxx

# ID server yang TIDAK BOLEH ikut dibersihkan /cleanserver (pisahkan koma). Default: 1
PROTECTED_SERVER_IDS=1

# (opsional tapi disarankan) token rahasia untuk validasi webhook Telegram
WEBHOOK_SECRET=isi-string-acak-disini

# Diisi manual setelah deploy pertama, dipakai oleh scripts/set-webhook.js
VERCEL_URL=https://project-kamu.vercel.app
